# Everything Store — Environment Variables
# Copy this file to .env and fill in your values.

# Supabase project URL (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET — never expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for SEO, sitemaps, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://digitalvaultsa.co.za
