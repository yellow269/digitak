# Everything Store — Environment Variables
# Copy this file to .env and fill in your values.

# Supabase project URL (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET — never expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for SEO, sitemaps, canonical URLs, and PayFast callbacks)
NEXT_PUBLIC_SITE_URL=https://digitak-r2m5.vercel.app

# PayFast credentials
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set to "true" for sandbox testing, leave empty or "false" for production
PAYFAST_SANDBOX=
